# Copie para .env e ajuste.
NODE_ENV=development

# Banco (portas do infra/docker-compose.yml)
DATABASE_URL=postgres://ofertas:ofertas@localhost:5433/ofertas
DATABASE_URL_TEST=postgres://ofertas:ofertas@localhost:5433/ofertas_test
REDIS_URL=redis://localhost:6380

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Permite criar novas contas além da primeira (o primeiro cadastro é sempre permitido)
ALLOW_SIGNUP=false

# Painel
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# Redirecionador (links curtos e convites)
REDIRECT_PORT=3002
REDIRECT_PUBLIC_URL=http://localhost:3002
# Segredo para anonimizar IPs dos cliques (LGPD). Gere um valor aleatório longo.
IP_HASH_SALT=troque-por-um-valor-aleatorio-longo

EVOLUTION_GO_API_KEY=
EVOLUTION_GO_URL=
EVOLUTION_GO_WEBHOOK_URL=
# URL pública base que a Evolution Go chama (a plataforma acrescenta /evolution_go).
# Padrão: API_PUBLIC_URL/webhooks/whatsapp
MESSAGING_WEBHOOK_URL=

# Chave para cifrar credenciais de terceiros (AES-256-GCM, 32 bytes em base64).
# Gere com: openssl rand -base64 32. Não troque depois de salvar credenciais.
ENCRYPTION_KEY=

# Imagens dos criativos (armazenamento local). Sem S3, as URLs usam API_PUBLIC_URL,
# que precisa ser acessível pela Evolution Go para enviar imagens no WhatsApp.
MEDIA_DIR=../../data/media

# Opcional: imagens no S3. A Evolution Go recebe um link assinado do bucket (vale 1 dia),
# então funciona mesmo com a API em localhost. AWS_REGION é opcional (descobre sozinho).
# O usuário IAM precisa de s3:GetObject, s3:PutObject e s3:DeleteObject no bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# Opcional: texto das ofertas gerado por IA no painel (Gemini). Chave do Google AI Studio
# (aistudio.google.com › Get API key). Sem ela, o botão "Gerar com IA" explica o que falta.
# Ou OpenRouter (tem prioridade se as duas chaves existirem). openrouter.ai › Keys.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
