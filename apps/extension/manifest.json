{
  "manifest_version": 3,
  "name": "OfZap",
  "version": "0.2.0",
  "description": "Cadastra ofertas no OfZap (Mercado Livre, Amazon, Shopee) e prepara os posts dos grupos do Facebook para você revisar e publicar.",
  "action": {
    "default_title": "OfZap",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "fb-bridge.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/groups/*"],
      "js": ["fb-core.js", "fb-group.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "tabs"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
