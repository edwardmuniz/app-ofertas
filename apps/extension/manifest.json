{
  "manifest_version": 3,
  "name": "OfZap",
  "version": "0.3.0",
  "description": "Cadastra ofertas, descobre grupos do Facebook e publica convites pontuais com imagem e texto escolhidos por você.",
  "action": {
    "default_title": "OfZap",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "fb-bridge.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/groups/*"],
      "js": ["fb-replay-core.js", "fb-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.facebook.com/groups/*"],
      "js": ["fb-core.js", "fb-group.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "tabs",
    "unlimitedStorage"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
